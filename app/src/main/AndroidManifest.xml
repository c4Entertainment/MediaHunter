<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility for ExternalApps (domain/model/external): one line per registered app. -->
    <queries>
        <package android:name="com.deniscerri.ytdl" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.thunderdog.challegram" />
        <package android:name="org.telegram.plus" />
        <package android:name="tw.nekomimi.nekogram" />
    </queries>

    <application
        android:name=".MediaHunterApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Starting"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppCompat.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Share text, or select it and pick "Media Hunter", to search torrents
            for it. TorrentSearch's settings switch these on and off, so the
            names must match its standalone app's (.SendAlias, .ProcessTextAlias).
        -->
        <activity-alias
            android:name=".SendAlias"
            android:exported="true"
            android:label="@string/search_torrents_label"
            android:targetActivity="com.prajwalch.torrentsearch.ui.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ProcessTextAlias"
            android:exported="true"
            android:label="@string/search_torrents_label"
            android:targetActivity="com.prajwalch.torrentsearch.ui.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".lock.LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />
        <activity
            android:name=".presentation.movie_info.FullscreenActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:screenOrientation="sensorLandscape">
        </activity>
    </application>

</manifest>